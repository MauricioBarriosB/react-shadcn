# Use official Node image
FROM node:20-alpine

# Set environment variables
ENV HOST=0.0.0.0 PORT=3000
WORKDIR /app

# Copy dependency files first for better caching
COPY package*.json ./
COPY vite.config.ts ./

# Install dependencies
RUN npm ci

# Copy application files
COPY . .

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"]